# Copy this file to .env and fill in your real values.
# .env is gitignored, so your key is never committed.

# Base endpoint from Azure AI Foundry -> Models + endpoints -> Get endpoint
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"

# Secret API key (do not commit). Paste from the Get endpoint panel.
AZURE_OPENAI_API_KEY="<your-key>"

# The deployment name shown in Foundry (NOT the model name).
AZURE_OPENAI_IMAGE_DEPLOYMENT="gpt-image-2"

# API version from the Get endpoint sample code. Adjust if you get a 404.
AZURE_OPENAI_API_VERSION="2025-04-01-preview"

AZURE_OPENAI_CHAT_ENDPOINT="https://<resource>.openai.azure.com"
AZURE_OPENAI_CHAT_KEY="<chat-key>"
AZURE_OPENAI_CHAT_DEPLOYMENT="DeepSeek-V4-Pro"
