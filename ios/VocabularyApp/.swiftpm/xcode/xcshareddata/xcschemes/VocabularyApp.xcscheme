<?xml version="1.0" encoding="UTF-8"?>
<Scheme
   LastUpgradeVersion = "1700"
   version = "1.7">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "VocabularyApp"
               BuildableName = "VocabularyApp"
               BlueprintName = "VocabularyApp"
               ReferencedContainer = "container:">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES"
      shouldAutocreateTestPlan = "YES">
      <Testables>
         <TestableReference
            skipped = "NO">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "VocabularyAppTests"
               BuildableName = "VocabularyAppTests"
               BlueprintName = "VocabularyAppTests"
               ReferencedContainer = "container:">
            </BuildableReference>
         </TestableReference>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      allowLocationSimulation = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Create .app bundle"
               scriptText = "#!/bin/bash&#10;set -e&#10;BUILD_DIR=&quot;${BUILT_PRODUCTS_DIR}&quot;&#10;EXEC=&quot;VocabularyApp&quot;&#10;APP_DIR=&quot;${BUILD_DIR}/${EXEC}.app&quot;&#10;EXEC_PATH=&quot;${BUILD_DIR}/${EXEC}&quot;&#10;PLIST_SRC=&quot;${SRCROOT}/Sources/VocabularyApp/AppInfo.plist&quot;&#10;&#10;if [ ! -f &quot;${EXEC_PATH}&quot; ]; then&#10;    echo &quot;Executable not found, skipping.&quot;&#10;    exit 0&#10;fi&#10;&#10;rm -rf &quot;${APP_DIR}&quot;&#10;mkdir -p &quot;${APP_DIR}&quot;&#10;cp &quot;${EXEC_PATH}&quot; &quot;${APP_DIR}/${EXEC}&quot;&#10;&#10;if [ -f &quot;${PLIST_SRC}&quot; ]; then&#10;    cp &quot;${PLIST_SRC}&quot; &quot;${APP_DIR}/Info.plist&quot;&#10;fi&#10;&#10;# Copy resource bundles&#10;for bundle in &quot;${BUILD_DIR}&quot;/*.bundle; do&#10;    if [ -d &quot;${bundle}&quot; ]; then&#10;        cp -r &quot;${bundle}&quot; &quot;${APP_DIR}/&quot;&#10;    fi&#10;done&#10;&#10;echo &quot;App bundle created at ${APP_DIR}&quot;">
            </ActionContent>
         </ExecutionAction>
      </PostActions>
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "VocabularyApp"
            BuildableName = "VocabularyApp"
            BlueprintName = "VocabularyApp"
            ReferencedContainer = "container:">
         </BuildableReference>
      </BuildableProductRunnable>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
